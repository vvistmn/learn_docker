{
    "branches": [
        { "name": "master" },
        {
            "name": "story/US-+([0-9])",
            "prerelease": "story",
            "channel": "${name.replace(/^story\\//, '')}"
        },
        {
            "name": "release/(([0-9]+)(?:\\.([0-9x]+))?(?:\\.([0-9x]+)))?",
            "prerelease": "rc",
            "channel": "${name.replace(/^release\\//, '')}"
        },
        {
            "name": "develop",
            "prerelease": "dev"
        }
    ],
    "tagFormat": "v${version}",
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "releaseRules": [
                    { "type": "build", "release": false },
                    { "type": "chore", "release": false },
                    { "type": "chore", "scope": "deps", "release": "patch"},
                    { "type": "ci", "release": false },
                    { "type": "docs", "release": false },
                    { "type": "feat", "release": "minor" },
                    { "type": "fix", "release": "patch" },
                    { "type": "perf", "release": false },
                    { "type": "ref", "release": false },
                    { "type": "refactor", "release": false },
                    { "type": "style", "release": false },
                    { "type": "test", "release": false}
                ],
                "parserOpts": {
                    "noteKeywords": [
                        "BREAKING CHANGE",
                        "BREAKING CHANGES",
                        "BREAKING"
                    ]
                }
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "presetConfig": [
                    { "type": "build", "section": "Build System", "hidden": true },
                    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
                    { "type": "chore", "scope": "deps", "section": "Dependency upgrades" },
                    { "type": "ci", "section": "Continuous Integration", "hidden": true },
                    { "type": "docs", "section": "Documentation", "hidden": true },
                    { "type": "feat", "section": "Features" },
                    { "type": "fix", "section": "Bug Fixes" },
                    { "type": "perf", "section": "Performance Improvements", "hidden": true },
                    { "type": "ref", "section": "Code Refactoring", "hidden": true },
                    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
                    { "type": "style", "section": "Styles", "hidden": true },
                    { "type": "test", "section": "Tests", "hidden": true}
                ],
                "linkCompare": true,
                "parserOpts": {
                    "noteKeywords": [
                        "BREAKING CHANGE",
                        "BREAKING CHANGES",
                        "BREAKING"
                    ]
                },
                "writerOpts": {
                    "commitsSort": [
                        "scope",
                        "subject"
                    ]
                }
            }
        ],
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "docs/CHANGELOG.md",
                "changelogTitle": "# Changelog"
            }
        ],
        [
            "semantic-release-replace-plugin",
            {
                "replacements": [
                    {
                        "files": [
                            "setup.cfg"
                        ],
                        "from": "^version = \\d+\\.\\d+\\.\\d*(-\\w+\\.\\d+)?$",
                        "to": "version = ${nextRelease.version}",
                        "countMatches": true,
                        "verbose": true,
                        "results": [
                            {
                                "file": "setup.cfg",
                                "hasChanged": true,
                                "numMatches": 1,
                                "numReplacements": 1
                            }
                        ]
                    },
                    {
                        "files": [
                            "VERSION"
                        ],
                        "from": "^\\d+\\.\\d+\\.\\d*(-\\w+\\.\\d+)?$",
                        "to": "${nextRelease.version}",
                        "countMatches": true,
                        "verbose": true,
                        "results": [
                            {
                                "file": "VERSION",
                                "hasChanged": true,
                                "numMatches": 1,
                                "numReplacements": 1
                            }
                        ]
                    }
                ]
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "setup.cfg",
                    "VERSION",
                    "docs/CHANGELOG.md"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]"
            }
        ],
        [
            "@semantic-release/gitlab",
            {
                "gitlabUrl": "https://git.itt.works"
            }
        ]
    ]
}
